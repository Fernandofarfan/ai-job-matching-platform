# =================================================================
# 🤖 EMPLEOIA - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =================================================================
# Instrucciones:
# 1. Copiá este archivo como '.env' en la raíz del proyecto.
# 2. Completá los valores con tus credenciales.
# 3. NUNCA subas el archivo '.env' a un repositorio público.
# =================================================================

# -----------------------------------------------------------------
# 🧠 CORE & INTELIGENCIA ARTIFICIAL
# -----------------------------------------------------------------
# Obtené tu API key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui
# Modelo de Gemini (SDK google-genai)
GEMINI_MODEL=gemini-2.5-flash
# modelo barato para extraer salarios y clasificar correos; vacío = GEMINI_MODEL
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------------
# 🔐 SEGURIDAD
# -----------------------------------------------------------------
# Clave para firmar sesiones (obligatoria en producción). Generala con: python -c "import secrets; print(secrets.token_hex(32))"
# Vacía = clave temporal aleatoria (las sesiones se pierden al reiniciar).
SECRET_KEY=
# Login con cuentas (email + contraseña). La primera cuenta se crea en /register y se queda con los datos previos.
# Email obligatorio para esa primera cuenta (recomendado en servidores públicos: nadie más puede reclamar la instancia).
ADMIN_EMAIL=
# true = cualquiera puede crear cuenta en /register (cada una gasta tu cuota de Gemini). Por defecto solo la primera.
ALLOW_SIGNUP=false
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_BASE_URL=
# false = sin login ni cuentas (solo para uso local de una persona).
LOGIN_REQUIRED=true
# Cifrado en reposo de los CVs subidos. Generala con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardala bien: sin ella no se pueden leer los CVs cifrados. Vacía = CVs sin cifrar.
CV_ENCRYPTION_KEY=
# Días que se guardan los CVs, sus perfiles y los documentos generados (0 = sin borrado automático)
CV_RETENTION_DAYS=0
# Aviso por email ante un login desde un navegador nuevo (true/false)
LOGIN_ALERTS=true
# Días que se guardan los eventos de seguridad (0 = sin borrar)
SECURITY_EVENTS_DAYS=180
# Token para la extensión de Chrome cuando hay login (pegalo en la configuración de la extensión)
EXTENSION_TOKEN=
# 1 si la app se sirve por HTTPS (cookies de sesión solo por HTTPS)
SESSION_COOKIE_SECURE=0
# CSP: 1 = solo reporta sin bloquear; CSP_REPORT_URI recibe los reportes
CSP_REPORT_ONLY=0
CSP_REPORT_URI=
# Documentación interactiva de la API en /docs (apagada en producción)
ENABLE_API_DOCS=0
# Orígenes permitidos para WebSockets (separados por coma). Vacío = solo mismo origen.
# Servidor de desarrollo (python app.py, uvicorn main:app). Nunca uses FLASK_DEBUG=1 expuesto a la red.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0
# Tamaño máximo de CV subido (MB)
MAX_UPLOAD_MB=16
# Límites por cuenta (por IP si no hay sesión), sintaxis de la librería limits ('10 per minute'). Con varias instancias usá redis:// en RATELIMIT_STORAGE_URI
AI_RATE_LIMIT=30 per minute
API_RATE_LIMIT=300 per minute
# Detrás de un proxy (Cloud Run, nginx): cuántas IPs del final de X-Forwarded-For agregó tu propio proxy. 0 = no hay proxy
TRUSTED_PROXY_HOPS=0
RATELIMIT_STORAGE_URI=memory://
# Consumo de Gemini: tope mensual de tokens (0 = sin tope), caché de respuestas (s) y precios por millón de tokens para estimar el costo
AI_MONTHLY_TOKEN_LIMIT=0
AI_USER_MONTHLY_TOKEN_LIMIT=0
AI_CACHE_TTL=3600
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Scrapers: timeout de carga por página (s) e intentos por página
SCRAPER_PAGE_TIMEOUT=30
SCRAPER_MAX_ATTEMPTS=3
# false abre la ventana de Chromium; PLAYWRIGHT_WS_ENDPOINT usa un navegador remoto (ws://...)
SCRAPER_HEADLESS=true
PLAYWRIGHT_WS_ENDPOINT=
# Observabilidad (opcional)
LOG_LEVEL=INFO
# Errores de producción a Sentry: 500 de la web y tareas de Celery que fallan, sin datos personales
SENTRY_DSN=
SENTRY_ENVIRONMENT=development   # en Cloud Run lo pone Terraform (staging/prod)
SENTRY_RELEASE=                  # vacío = K_REVISION en Cloud Run
SENTRY_TRACES_SAMPLE_RATE=0

# -----------------------------------------------------------------
# 🗄️ BASE DE DATOS (MySQL)
# -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=job_tracker
DB_POOL_SIZE=5
DB_POOL_NAME=job_pool_v2
# Perfiles de CV: mysql (tabla user_profiles, por defecto) o json (profiles/user_profiles.json)
PROFILE_STORAGE=mysql

# -----------------------------------------------------------------
# ⚡ CELERY + REDIS (Tareas Asíncronas)
# -----------------------------------------------------------------
# Para desarrollo local: instalar Redis o usar Docker
# Windows: usar WSL2 o Docker Desktop con redis:7-alpine
REDIS_URL=redis://localhost:6379/0
# thread (por defecto): los scrapers corren dentro del proceso web
# celery: corren en el worker (celery -A celery_app worker -Q scraping) y sobreviven a reinicios
SCRAPER_BACKEND=thread
# sync (por defecto): las cartas y CVs en lote se generan dentro del pedido web
# celery: se generan en el worker (cola ai_processing) y la página consulta el progreso
AI_BACKEND=sync
# Carpeta de cartas y CVs generados; con worker tiene que ser compartida con la web
GENERATED_DIR=temp
# Auto-Apply de LinkedIn (experimental, tarea tasks.ai_tasks.auto_apply_jobs). Apagado por defecto:
# postular con bots puede violar los términos de LinkedIn y hacer que te bloqueen la cuenta.
AUTO_APPLY_ENABLED=false
# Con false solo recorre el formulario de Easy Apply sin enviarlo
AUTO_APPLY_SUBMIT=false

# -----------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------
# /metrics (Prometheus) responde solo con 'Authorization: Bearer <token>'; vacío = 404
METRICS_TOKEN=
# Trazas OpenTelemetry por OTLP/HTTP (web y worker); vacío = apagadas
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=empleoia
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# -----------------------------------------------------------------
# 🔍 SCRAPER: INDEED (Vía Google Login)
# -----------------------------------------------------------------
INDEED_EMAIL=tu_email_google@gmail.com
INDEED_PASSWORD=tu_password_google

# NOTA: Si tenés 2FA (verificación en 2 pasos) activa en Google:
# - Deberás aprobar el login en tu celular al iniciar el scraper.
# - O podés usar una "Contraseña de Aplicación" de Google.

# -----------------------------------------------------------------
# 🔍 SCRAPER: LINKEDIN
# -----------------------------------------------------------------
# Opción A: Email y Contraseña (Recomendado para inicio automático)
LINKEDIN_EMAIL=tu_email@ejemplo.com
LINKEDIN_PASSWORD=tu_password

# Opción B: Cookie 'li_at' (Más estable contra bloqueos)
# Obtenela de: Herramientas desarrollador -> Application -> Cookies
LINKEDIN_TOKEN=tu_linkedin_cookie_token

# -----------------------------------------------------------------
# 🔍 SCRAPERS: BUMERAN & COMPUTRABAJO (Opcional)
# -----------------------------------------------------------------
BUMERAN_EMAIL=tu_email@ejemplo.com
BUMERAN_PASSWORD=tu_password

COMPUTRABAJO_EMAIL=tu_email@ejemplo.com
COMPUTRABAJO_PASSWORD=tu_password

# -----------------------------------------------------------------
# 📧 NOTIFICACIONES POR EMAIL (SMTP)
# -----------------------------------------------------------------
# Para Gmail: usá una Contraseña de Aplicación (no tu contraseña normal)
# Crear en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_google
# Proveedor: smtp (por defecto; SES SMTP también) o sendgrid
EMAIL_PROVIDER=smtp
# Remitente (por defecto SMTP_USER); obligatorio con SendGrid
EMAIL_FROM=
SENDGRID_API_KEY=
# Clave pública del Event Webhook firmado de SendGrid (rebotes y spam a POST /webhooks/sendgrid)
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Reintentos ante fallas temporales y espera inicial en segundos (se duplica en cada intento)
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_SECONDS=1
# Destinatario de las alertas (por defecto, SMTP_USER)
NOTIFICATION_EMAIL=

# 🧠 MATCHING CV-OFERTA
# tfidf (palabras en común, sin costo) o embeddings (significado, usa Gemini y cuenta en AI_MONTHLY_TOKEN_LIMIT)
MATCHING_BACKEND=tfidf
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 🔔 ALERTAS DE EMPLEO (/alerts)
# Telegram: creá un bot con @BotFather y obtené tu chat_id escribiéndole a @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notificaciones push (PWA): generá las claves con `python scripts/generate_vapid_keys.py`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o URL de contacto para los servicios de push (por defecto mailto:ADMIN_EMAIL)
VAPID_SUBJECT=
# Cada cuántas horas Celery Beat revisa las búsquedas guardadas
ALERTS_INTERVAL_HOURS=6
# Recordatorio de seguimiento N días después de postular si no fijaste fecha (0 lo desactiva)
FOLLOWUP_DAYS=7
# URL pública de la app para los links de los emails
APP_BASE_URL=http://localhost:5000
# Email donde recibirás las notificaciones
NOTIFICATION_EMAIL=tu_email@gmail.com

# -----------------------------------------------------------------
# 🌸 FLOWER DASHBOARD (Monitor de Celery)
# -----------------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=admin123

# Ranking personal: peso (0-1) de lo aprendido del tracker frente al match del CV,
# y días que una oferta guardada sin postular tarda en contar como "no me interesa"
RANKING_WEIGHT=0.3
RANKING_STALE_DAYS=14

# -----------------------------------------------------------------
# ☁️ DESPLIEGUE EN LA NUBE (Solo si usás Docker/Terraform)
# -----------------------------------------------------------------
# GCP Project ID (para Terraform)
# GCP_PROJECT_ID=mi-proyecto-gcp

# Entrar con Google (cliente OAuth "aplicación web"; redirect URI: PUBLIC_BASE_URL + /login/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Términos y Privacidad (/terms, /privacy): quién ofrece el servicio y email de contacto (por defecto ADMIN_EMAIL)
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
